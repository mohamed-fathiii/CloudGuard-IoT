# ============================================================
#  انسخ الملف ده لـ .env  —  ⚠️ .env مترفعش على GitHub أبداً
# ============================================================

# --- المسار الموصى به: SSH Tunnel على 127.0.0.1 ---
DATABASE_URL="postgresql://postgres:PUT_REAL_PASSWORD@127.0.0.1:5432/postgres"

# --- المسار المباشر (لو الـ RDS public مؤقتاً) ---
# DATABASE_URL="postgresql://postgres:PUT_REAL_PASSWORD@cloudguard-db1.c7uy2kk4edth.eu-north-1.rds.amazonaws.com:5432/postgres?sslmode=require"

# لوج كل SQL في الـ console
DRIZZLE_LOG="false"

# ============================================================
#  ملاحظة عن الباسورد:
#  لو فيه @ أو # أو : أو / لازم URL-encode
#    @ → %40     # → %23     : → %3A     / → %2F
#  مثال:  Pass@123  →  Pass%40123
# ============================================================
