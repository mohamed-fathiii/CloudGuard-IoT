# Frontend runtime configuration — copy to .env.local for local overrides.
# Never put passwords, tokens, AWS keys or Auth.js secrets in NEXT_PUBLIC_* values.

# 1 = use the labelled demo fixtures (default). 0 = call the real API adapter.
NEXT_PUBLIC_USE_MOCK_DATA=1

# Base path for all /api/v1 requests. A same-origin proxy keeps this relative.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Public base URL used by the backend/Auth.js callbacks. Keep aligned with the
# dev/start scripts, which run on port 3100.
APP_BASE_URL=http://localhost:3100
